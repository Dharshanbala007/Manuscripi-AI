# ManuScript AI backend configuration. Copy to .env and adjust as needed.
# All values below are the built-in development defaults.

APP_ENV=development
HOST=127.0.0.1
PORT=8000

# JSON array of allowed browser origins for CORS.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=25

# Root directory for per-document working files (created if missing).
WORK_DIR=./.workspace

# Age (minutes) after which an idle document workspace is swept on startup.
WORKSPACE_TTL_MIN=120

# Classification/extraction results below this score are flagged for review.
CONFIDENCE_THRESHOLD=0.6

# Path to the LibreOffice `soffice` binary. Empty = auto-detect on PATH.
# Windows default install: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# Seconds to allow a single DOCX->PDF conversion before timing out.
PDF_TIMEOUT_S=60

# Local document-history database (SQLite). Log-only: no manuscript content.
HISTORY_DB=./.workspace/history.db
HISTORY_ENABLED=true

LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
